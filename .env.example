# Copy to `.env` and adjust for your machine. The API URL is not a secret.
#
# Android emulator (API on host machine, port 5000):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# Physical Android device on the same Wi‑Fi as your dev machine:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
#
# iOS simulator (API on host):
# EXPO_PUBLIC_API_URL=http://localhost:5000

EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Copy to `.env`. Required even when dev auto-resolution is used (see README).
#
# Dev resolution (getApiBaseUrl):
# - Physical phone + Expo Go → same LAN IP as Metro (from QR), port 5000
# - Android emulator → http://10.0.2.2:5000
# - iOS simulator → http://localhost:5000
#
# Override for production / custom staging:
# EXPO_PUBLIC_API_URL=https://api.example.com

EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
